# Database (Neon Postgres)
# DATABASE_URL: pooled connection used by the app at runtime.
# DIRECT_URL:   direct (non-pooled) connection used by Prisma for migrations.
DATABASE_URL=""
DIRECT_URL=""

# Prisma adapter selection.
# Leave blank (or 'neon') to use the Neon serverless driver; set to 'pg' for a
# direct Postgres connection (e.g. local Docker).
DATABASE_ADAPTER=""

# Vercel AI Gateway — single credential for provider-agnostic model access.
AI_GATEWAY_API_KEY=""

# Model selection (optional — sensible defaults are used if unset).
# COMPOSE_* drives the single-pass brief composer (triage + cluster + write);
# NEWSLETTER_CLEANUP_* drives the cheap HTML→Markdown cleanup of each newsletter.
# Reasoning: provider-default | none | minimal | low | medium | high | xhigh.
# COMPOSE_FALLBACK_MODEL is retried when COMPOSE_MODEL returns no usable brief —
# keep it on a different provider, since the usual cause is a safety filter that
# one provider trips on a news item and another doesn't. Set it equal to
# COMPOSE_MODEL for a single attempt and no retry.
COMPOSE_MODEL=""
COMPOSE_FALLBACK_MODEL=""
COMPOSE_REASONING=""
NEWSLETTER_CLEANUP_MODEL=""
NEWSLETTER_CLEANUP_REASONING=""

# Gmail API (OAuth 2.0)
# One Google OAuth client with the gmail.modify scope — it covers reading and
# labeling newsletters as well as sending the brief. Obtain the refresh token
# once via the consent flow.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""

# Email routing
# BRIEF_SENDER is the authenticated Gmail account the brief is sent from.
# BRIEF_RECIPIENT is the only address the brief is ever sent to. The run reads it
# from here and throws if it's unset — it never falls back to another address.
BRIEF_SENDER=""
BRIEF_RECIPIENT=""
